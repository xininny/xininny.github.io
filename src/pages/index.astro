---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const catCount = new Map<string, number>();
for (const p of posts) {
	const c = p.data.category;
	if (c) catCount.set(c, (catCount.get(c) ?? 0) + 1);
}
const categories = [...catCount.entries()].sort((a, b) => b[1] - a[1]);
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Fragment slot="side">
		<ProfileCard />

		<nav class="widget card cats" id="cat-filter">
			<button class="cat active" data-cat="all">
				<span>All</span><span class="n">{posts.length}</span>
			</button>
			{
				categories.map(([c, n]) => (
					<button class="cat" data-cat={c}>
						<span>{c}</span>
						<span class="n">{n}</span>
					</button>
				))
			}
		</nav>
	</Fragment>

	<div class="searchbar">
		<label class="search-label" for="search">🔍 Search</label>
		<input id="search" type="search" placeholder="Search Keyword..." autocomplete="off" />
	</div>

	<div class="cards" id="cards">
		{posts.map((post) => <PostCard post={post} />)}
	</div>
	<p class="empty" id="empty" hidden>표시할 글이 없어요 😺</p>
</PageLayout>

<script is:inline>
	(function () {
		const cards = Array.from(document.querySelectorAll('#cards .post-card'));
		const catBtns = Array.from(document.querySelectorAll('#cat-filter .cat'));
		const search = document.getElementById('search');
		const empty = document.getElementById('empty');
		let activeCat = 'all';
		let query = '';

		function apply() {
			let shown = 0;
			for (const card of cards) {
				const cat = card.getAttribute('data-category') || '';
				const title = card.getAttribute('data-title') || '';
				const okCat = activeCat === 'all' || cat === activeCat;
				const okQuery = !query || title.includes(query);
				const show = okCat && okQuery;
				card.style.display = show ? '' : 'none';
				if (show) shown++;
			}
			if (empty) empty.hidden = shown !== 0;
		}

		catBtns.forEach((b) =>
			b.addEventListener('click', () => {
				activeCat = b.getAttribute('data-cat');
				catBtns.forEach((x) => x.classList.toggle('active', x === b));
				apply();
			}),
		);
		if (search) {
			search.addEventListener('input', () => {
				query = search.value.trim().toLowerCase();
				apply();
			});
		}
	})();
</script>

<style>
	.widget {
		padding: 1rem 1.1rem;
	}
	.searchbar {
		margin-bottom: 1.4rem;
	}
	.search-label {
		display: block;
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-strong);
		margin-bottom: 0.55rem;
	}
	#search {
		width: 100%;
		box-sizing: border-box;
		padding: 0.85rem 1.1rem;
		border: 1px solid transparent;
		border-radius: 12px;
		background: var(--bg-secondary);
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
	}
	#search::placeholder {
		color: var(--faint);
	}
	#search:focus {
		outline: none;
		border-color: var(--border-strong);
	}
	.cats {
		display: grid;
		gap: 0.1rem;
		padding: 0.5rem;
	}
	.cat {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
		padding: 0.4rem 0.6rem;
		border: none;
		border-radius: 7px;
		background: transparent;
		color: var(--muted);
		text-align: left;
	}
	.cat .n {
		color: var(--faint);
		font-size: 0.82em;
	}
	.cat:hover {
		background: var(--hover);
		color: var(--text-strong);
	}
	.cat.active {
		background: var(--sel);
		color: var(--text-strong);
		font-weight: 600;
	}
	.cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.8rem;
	}
	.empty {
		text-align: center;
		color: var(--muted);
		padding: 3rem 0;
	}
</style>
