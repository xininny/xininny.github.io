---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { notionColor } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, heroImage, category, tags } = Astro.props;
const catColor = notionColor(category);

const fmt = (v: Date) => {
	const d = new Date(v);
	return `${d.getUTCFullYear()}년 ${d.getUTCMonth() + 1}월 ${d.getUTCDate()}일`;
};
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post">
			<a class="back" href="/">← 목록으로</a>
			<article class="sheet">
				<header class="post-head">
					{category && <span class={`nt nt-${catColor} category`}>{category}</span>}
					<h1>{title}</h1>
					<div class="date">{fmt(pubDate)}</div>
					{
						tags && tags.length > 0 && (
							<div class="post-tags">
								{tags.map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
						)
					}
					{
						heroImage && (
							<div class="hero-image">
								<Image width={1020} height={510} src={heroImage} alt="" />
							</div>
						)
					}
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>

		<style>
			.post {
				max-width: 820px;
				margin: 0 auto;
				padding: 1.5rem 20px 3rem;
			}
			.back {
				display: inline-block;
				margin-bottom: 1.2rem;
				color: var(--muted);
				font-size: 0.9rem;
			}
			.back:hover {
				color: var(--text-strong);
				text-decoration: none;
			}
			.sheet {
				background: var(--surface);
				border-radius: 16px;
				padding: 2.6rem 2.8rem;
			}
			.post-head {
				margin-bottom: 2rem;
			}
			.category {
				margin-bottom: 0.9rem;
			}
			.post-head h1 {
				font-size: 2rem;
				margin: 0 0 0.7rem;
			}
			.date {
				color: var(--faint);
				font-size: 0.88rem;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.9rem;
			}
			.tag {
				font-size: 0.78rem;
				color: var(--nt-gray-fg);
				background: var(--nt-gray-bg);
				padding: 0.15rem 0.6rem;
				border-radius: 6px;
			}
			.hero-image {
				margin-top: 1.5rem;
			}
			.hero-image :global(img) {
				display: block;
				width: 100%;
				border-radius: 8px;
			}
			@media (max-width: 620px) {
				.sheet {
					padding: 1.6rem 1.4rem;
				}
			}
		</style>
	</body>
</html>
