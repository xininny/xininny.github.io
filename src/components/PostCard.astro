---
import type { CollectionEntry } from 'astro:content';
import { notionColor } from '../consts';

interface Props {
	post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, category, tags } = post.data;
const color = notionColor(category);

const d = new Date(pubDate);
const dateStr = `${d.getUTCFullYear()}년 ${d.getUTCMonth() + 1}월 ${d.getUTCDate()}일`;
---

<article
	class="post-card"
	data-category={category ?? ''}
	data-tags={(tags ?? []).join('|')}
	data-title={`${title} ${description ?? ''}`.toLowerCase()}
>
	<a href={`/blog/${post.id}/`} class="card-link">
		{category && <span class={`nt nt-${color} category`}>{category}</span>}
		<h3 class="title">{title}</h3>
		<time class="date">{dateStr}</time>
		{description && <p class="desc">{description}</p>}
		{
			tags && tags.length > 0 && (
				<div class="tags">
					{tags.map((t) => (
						<span class="tag">{t}</span>
					))}
				</div>
			)
		}
	</a>
</article>

<style>
	.post-card {
		border-radius: var(--radius);
		background: var(--surface);
		transition: box-shadow 0.18s ease;
	}
	.post-card:hover {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.09), 0 2px 6px rgba(0, 0, 0, 0.05);
	}
	:global([data-theme='dark']) .post-card:hover {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.4);
	}
	.card-link {
		display: block;
		padding: 1.3rem 1.4rem;
		color: inherit;
	}
	.card-link:hover {
		text-decoration: none;
	}
	.category {
		margin-bottom: 0.7rem;
	}
	.title {
		margin: 0 0 0.4rem;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-strong);
		line-height: 1.4;
	}
	.date {
		display: block;
		font-size: 0.8rem;
		color: var(--faint);
		margin-bottom: 0.7rem;
	}
	.desc {
		margin: 0 0 0.9rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.tag {
		font-size: 0.76rem;
		padding: 0.15rem 0.55rem;
		border-radius: 6px;
		background: var(--nt-gray-bg);
		color: var(--nt-gray-fg);
	}
</style>
